rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'ak750258@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMember(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.designation is string && data.designation.size() >= 2 &&
             data.committeeWing is string &&
             data.phoneNumber is string;
    }

    function isValidNotice(data) {
      return data.title is string && data.title.size() >= 2 &&
             data.content is string && data.content.size() >= 2 &&
             data.issuedBy is string;
    }

    function isValidDonation(data) {
      return data.donorName is string && data.donorName.size() >= 2 &&
             data.amount is number && data.amount >= 0 &&
             data.purpose is string;
    }

    function isValidExpense(data) {
      return data.title is string && data.title.size() >= 2 &&
             data.amount is number && data.amount >= 0 &&
             data.category is string;
    }

    function isValidChatMessage(data) {
      return data.messageText is string && data.messageText.size() >= 1 &&
             data.channelId is string &&
             data.senderName is string;
    }

    function isValidMeeting(data) {
      return data.title is string && data.title.size() >= 2 &&
             data.venue is string &&
             data.agenda is string;
    }

    function isValidDocument(data) {
      return data.title is string && data.title.size() >= 2 &&
             data.category is string &&
             data.refCode is string;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Members Directory (All committee members)
    match /members/{memberId} {
      allow read: if true;
      allow create: if isValidId(memberId) && isValidMember(incoming());
      allow update: if isValidId(memberId) && isValidMember(incoming());
      allow delete: if isValidId(memberId);
    }

    // 2. Notices & Announcements (Live notice board)
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isValidId(noticeId) && isValidNotice(incoming());
      allow update: if isValidId(noticeId) && isValidNotice(incoming());
      allow delete: if isValidId(noticeId);
    }

    // 3. Donations & Chanda Vivran (Live donation records)
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isValidId(donationId) && isValidDonation(incoming());
      allow update: if isValidId(donationId) && isValidDonation(incoming());
      allow delete: if isValidId(donationId);
    }

    // 4. Expenses (Kharch Vivran)
    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isValidId(expenseId) && isValidExpense(incoming());
      allow delete: if isValidId(expenseId);
    }

    // 5. Live Committee Chat Messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidChatMessage(incoming());
      allow update: if isValidId(messageId) && isValidChatMessage(incoming());
      allow delete: if isValidId(messageId);
    }

    // 6. Committee Meetings
    match /meetings/{meetingId} {
      allow read: if true;
      allow create: if isValidId(meetingId) && isValidMeeting(incoming());
      allow update: if isValidId(meetingId) && isValidMeeting(incoming());
      allow delete: if isValidId(meetingId);
    }

    // 7. Official Documents
    match /documents/{documentId} {
      allow read: if true;
      allow create: if isValidId(documentId) && isValidDocument(incoming());
      allow update: if isValidId(documentId) && isValidDocument(incoming());
      allow delete: if isValidId(documentId);
    }

    // 8. Global Configuration (e.g. Donation Goal)
    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isValidId(configId);
    }
  }
}
